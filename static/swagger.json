{
  "openapi": "3.0.0",
  "info": {
    "title": "API Divas Pop",
    "description": "API para gerenciar informações de Divas da música Pop.",
    "version": "1.0.0"
  },
  "paths": {
    "/divas": {
      "get": {
        "summary": "Consulta todas as divas",
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cadastra uma nova diva",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Beyoncé" },
                  "nacionalidade": {
                    "type": "string",
                    "example": "Estados Unidos"
                  },
                  "ano_nascimento": { "type": "integer", "example": 1981 },
                  "maior_hit": { "type": "string", "example": "Crazy in Love" },
                  "premios_grammy": { "type": "integer", "example": 32 },
                  "estilo": { "type": "string", "example": "R&B" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Cadastrado com sucesso" } }
      }
    },
    "/divas/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "summary": "Consulta uma diva por ID",
        "responses": { "200": { "description": "Sucesso" } }
      },
      "put": {
        "summary": "Atualiza os dados de uma diva",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "nacionalidade": { "type": "string" },
                  "ano_nascimento": { "type": "integer" },
                  "maior_hit": { "type": "string" },
                  "premios_grammy": { "type": "integer" },
                  "estilo": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Atualizado com sucesso" } }
      },
      "delete": {
        "summary": "Exclui uma diva",
        "responses": { "200": { "description": "Excluído com sucesso" } }
      }
    }
  }
}
